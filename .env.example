# Odoo Online / Odoo 18
ODOO_URL=https://edu-lokalmart.odoo.com
ODOO_DB=edu-lokalmart
ODOO_USERNAME=admin@example.com
# Gunakan API key Odoo, bukan password login utama.
ODOO_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Token rahasia untuk membuka bridge dari UI / ChatGPT.
LM_ADMIN_TOKEN=ganti-token-panjang-random

# Opsional: batasi origin frontend. Pisahkan dengan koma.
# ALLOWED_ORIGINS=https://nama-app.vercel.app,http://localhost:3000

# Opsional: limit default export agar tidak timeout.
LM_DEFAULT_LIMIT=300
LM_MAX_LIMIT=1500
